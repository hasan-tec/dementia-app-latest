# Supabase Public Client Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Optional: Application URL for email confirmation redirects (defaults to window.location.origin)
# When deploying to Vercel/Netlify or testing on mobile via LAN IP/ngrok, set this:
# VITE_APP_URL=https://your-domain.com

# Optional: Supabase Edge Functions Base URL (defaults to ${VITE_SUPABASE_URL}/functions/v1/app-api)
# VITE_API_BASE_URL=https://your-project-id.supabase.co/functions/v1/app-api

